### Тестовые запросы к MP Proxy Service API
### Для работы установите расширение REST Client в VS Code

@baseUrl = http://localhost:3000
@adminEmail = admin@mp-proxy.local
@adminPassword = admin123
@wbApiKey = ваш_wildberries_api_key
@msapimpKey = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..WY-4Z4RD3TECSYTZFRYS9_cPpwOO9LY1OhqhrjdNNbs

# =============================================================================
# 📦 msapimp-options примеры (Base64-encoded JSON)
# =============================================================================
# 
# {"paginate":true} = eyJwYWdpbmF0ZSI6dHJ1ZX0=
# {"paginate":false} = eyJwYWdpbmF0ZSI6ZmFsc2V9
# {"paginate":true,"limit":500} = eyJwYWdpbmF0ZSI6dHJ1ZSwibGltaXQiOjUwMH0=
# {"priority":"high"} = eyJwcmlvcml0eSI6ImhpZ2gifQ==
# =============================================================================

# =============================================================================
# 1. ПОЛУЧЕНИЕ ACCESS ТОКЕНА
# =============================================================================

### POST /auth/login - Получение токена доступа
# @name loginRequest
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Сохраняем токен из ответа
@accessToken = {{loginRequest.response.body.access_token}}

# =============================================================================
# 2. ПРОВЕРКА ТЕКУЩЕЙ СЕССИИ
# =============================================================================

### GET /auth/me - Информация о текущем пользователе
GET {{baseUrl}}/auth/me
msapimp-key-api: {{msapimpKey}}

# =============================================================================
# 3. ЗАПРОСЫ К WILDBERRIES STATISTICS API
# =============================================================================

### GET /api/v1/proxy/statistics-api.wildberries.ru/api/v1/supplier/orders
# Получение данных о заказах продавца (с пагинацией, msapimp-options)
# msapimp-options: {"paginate":true,"limit":100} = eyJwYWdpbmF0ZSI6dHJ1ZSwibGltaXQiOjEwMH0=
GET https://statistics-api.wildberries.ru/api/v1/supplier/orders?dateFrom=2026-03-20&flag=0
Authorization: eyJhbGciOiJFUzI1NiIsImtpZCI6IjIwMjUwOTA0djEiLCJ0eXAiOiJKV1QifQ.eyJhY2MiOjEsImVudCI6MSwiZXhwIjoxNzg0MDAyOTM5LCJpZCI6IjAxOWJiMzAzLWY0MjYtNzQ0MC04YzI3LWEyZDg4N2U1NTYzYiIsImlpZCI6MjA0MjM3NjkxLCJvaWQiOjg1MzM4LCJzIjo0MTU4LCJzaWQiOiJkYTVjNzMyOS1lMzU0LTU2ODYtOTViYy1kZGZiZDgxNDM1YmMiLCJ0IjpmYWxzZSwidWlkIjoyMDQyMzc2OTF9.2dVW8EApzzdau9ojtIcdjVhRWpUm4bUniBGFZH4g6Kvsw14aoApGBrycHe1bq4dCPZwVYPNr20R1eDf8jYJ9eA
msapimp-key-api: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..WY-4Z4RD3TECSYTZFRYS9_cPpwOO9LY1OhqhrjdNNbs
msapimp-options: eyJwYWdpbmF0ZSI6dHJ1ZSwibGltaXQiOjEwMH0=

### GET /api/v1/proxy/statistics-api.wildberries.ru/api/v1/supplier/orders
# Получение данных о заказах (без пагинации, одна страница)
# msapimp-options: {"paginate":false} = eyJwYWdpbmF0ZSI6ZmFsc2V9
GET https://statistics-api.wildberries.ru/api/v1/supplier/orders?dateFrom=2026-03-20&flag=0
Authorization: eyJhbGciOiJFUzI1NiIsImtpZCI6IjIwMjUwOTA0djEiLCJ0eXAiOiJKV1QifQ.eyJhY2MiOjEsImVudCI6MSwiZXhwIjoxNzg0MDAyOTM5LCJpZCI6IjAxOWJiMzAzLWY0MjYtNzQ0MC04YzI3LWEyZDg4N2U1NTYzYiIsImlpZCI6MjA0MjM3NjkxLCJvaWQiOjg1MzM4LCJzIjo0MTU4LCJzaWQiOiJkYTVjNzMyOS1lMzU0LTU2ODYtOTViYy1kZGZiZDgxNDM1YmMiLCJ0IjpmYWxzZSwidWlkIjoyMDQyMzc2OTF9.2dVW8EApzzdau9ojtIcdjVhRWpUm4bUniBGFZH4g6Kvsw14aoApGBrycHe1bq4dCPZwVYPNr20R1eDf8jYJ9eA
msapimp-key-api: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..WY-4Z4RD3TECSYTZFRYS9_cPpwOO9LY1OhqhrjdNNbs
msapimp-options: eyJwYWdpbmF0ZSI6ZmFsc2V9

### GET /api/v1/proxy/statistics-api.wildberries.ru/api/v1/supplier/products
# Получение данных о товарах (с высоким приоритетом)
# msapimp-options: {"priority":"high"} = eyJwcmlvcml0eSI6ImhpZ2gifQ==
GET {{baseUrl}}/api/v1/proxy/statistics-api.wildberries.ru/api/v1/supplier/products
msapimp-key-api: {{msapimpKey}}
msapimp-options: eyJwcmlvcml0eSI6ImhpZ2gifQ==

### GET /api/v1/proxy/statistics-api.wildberries.ru/api/v1/supplier/products
# Получение данных о товарах
GET {{baseUrl}}/api/v1/proxy/statistics-api.wildberries.ru/api/v1/supplier/products
msapimp-key-api: {{msapimpKey}}

### GET /api/v1/proxy/statistics-api.wildberries.ru/api/v1/supplier/stocks
# Получение данных об остатках на складах
GET {{baseUrl}}/api/v1/proxy/statistics-api.wildberries.ru/api/v1/supplier/stocks
msapimp-key-api: {{msapimpKey}}

### GET /api/v1/proxy/statistics-api.wildberries.ru/api/v1/supplier/cardorders
# Получение заказов по карточкам товаров
GET {{baseUrl}}/api/v1/proxy/statistics-api.wildberries.ru/api/v1/supplier/cardorders?dateFrom=2024-01-01T00:00:00
msapimp-key-api: {{msapimpKey}}

### GET /api/v1/proxy/statistics-api.wildberries.ru/api/v1/supplier/returns
# Получение данных о возвратах
GET {{baseUrl}}/api/v1/proxy/statistics-api.wildberries.ru/api/v1/supplier/returns?dateFrom=2024-01-01T00:00:00
msapimp-key-api: {{msapimpKey}}

### GET /api/v1/proxy/statistics-api.wildberries.ru/api/v1/supplier/reports
# Получение отчётов
GET {{baseUrl}}/api/v1/proxy/statistics-api.wildberries.ru/api/v1/supplier/reports?dateFrom=2024-01-01T00:00:00
msapimp-key-api: {{msapimpKey}}

# =============================================================================
# 4. ВЫХОД ИЗ СИСТЕМЫ (ОТЗЫВ ТОКЕНА)
# =============================================================================

### POST /auth/logout - Выход из системы
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "access_token": "{{accessToken}}"
}

# =============================================================================
# 5. СЛУЖЕБНЫЕ ЗАПРОСЫ
# =============================================================================

### GET /api/v1/health - Проверка здоровья сервиса
GET {{baseUrl}}/api/v1/health

### GET /docs - Swagger документация
GET {{baseUrl}}/docs

### GET /admin/login - Страница входа в админку
GET {{baseUrl}}/admin/login

# =============================================================================
# 6. ЗАПРОСЫ ОЧЕРЕДИ (Queue Management)
# =============================================================================

### GET /api/v1/queue/stats - Статистика очереди
# Получение общей статистики по всем запросам в очереди
GET {{baseUrl}}/api/v1/queue/stats
msapimp-key-api: {{msapimpKey}}

### GET /api/v1/queue - Список всех запросов в очереди
# Получение списка запросов с пагинацией
GET {{baseUrl}}/api/v1/queue?limit=50&offset=0
msapimp-key-api: {{msapimpKey}}

### GET /api/v1/queue?status=completed - Фильтрация по статусу
# Получение только завершённых запросов
GET {{baseUrl}}/api/v1/queue?status=completed&limit=20
msapimp-key-api: {{msapimpKey}}

### GET /api/v1/queue?status=processing - Запросы в обработке
# Получение запросов, которые сейчас обрабатываются
GET {{baseUrl}}/api/v1/queue?status=processing
msapimp-key-api: {{msapimpKey}}

### GET /api/v1/queue?status=failed - Ошибочные запросы
# Получение запросов с ошибками
GET {{baseUrl}}/api/v1/queue?status=failed
msapimp-key-api: {{msapimpKey}}

### GET /api/v1/queue/:uuid - Получение запроса по UUID
# Детальная информация о конкретном запросе в очереди
GET {{baseUrl}}/api/v1/queue/d87c29af-ce3a-4e91-9c94-e0c25cba4b45
msapimp-key-api: {{msapimpKey}}

### GET /api/v1/queue/:uuid - Другой пример запроса по UUID
GET {{baseUrl}}/api/v1/queue/8cb6387d-f0e7-4ac9-9e84-4a425a896028
msapimp-key-api: {{msapimpKey}}

### DELETE /api/v1/queue/:uuid - Удаление запроса из очереди
# Удаление конкретного запроса по UUID
DELETE {{baseUrl}}/api/v1/queue/d87c29af-ce3a-4e91-9c94-e0c25cba4b45
msapimp-key-api: {{msapimpKey}}

### POST /api/v1/queue/clear - Очистка завершенных запросов
# Очистка всех завершенных запросов (по умолчанию старше 1 часа)
POST {{baseUrl}}/api/v1/queue/clear
Content-Type: application/json
msapimp-key-api: {{msapimpKey}}

{
  "olderThan": "2026-03-27T00:00:00.000Z"
}

### POST /api/v1/queue/clear - Очистка без параметров (по умолчанию 1 час)
POST {{baseUrl}}/api/v1/queue/clear
Content-Type: application/json
msapimp-key-api: {{msapimpKey}}

# =============================================================================
# 7. АДМИНКА (Admin Panel)
# =============================================================================

### GET /admin/login - Страница входа в админку
GET {{baseUrl}}/admin/login

### GET /admin - Панель управления (требуется авторизация)
GET {{baseUrl}}/admin
msapimp-key-api: {{msapimpKey}}

### GET /admin/api/dashboard - Статистика дашборда
GET {{baseUrl}}/admin/api/dashboard
msapimp-key-api: {{msapimpKey}}

### GET /admin/api/clients - Список клиентов
GET {{baseUrl}}/admin/api/clients
msapimp-key-api: {{msapimpKey}}

### GET /admin/api/access_tokens - Список токенов
GET {{baseUrl}}/admin/api/access_tokens
msapimp-key-api: {{msapimpKey}}

### GET /admin/api/requests - Список запросов
GET {{baseUrl}}/admin/api/requests
msapimp-key-api: {{msapimpKey}}

### GET /admin/api/logs - Логи системы
GET {{baseUrl}}/admin/api/logs
msapimp-key-api: {{msapimpKey}}

### GET /admin/api/auth_logs - Логи аутентификации
GET {{baseUrl}}/admin/api/auth_logs
msapimp-key-api: {{msapimpKey}}

### GET /admin/api/audit_logs - Аудит логи
GET {{baseUrl}}/admin/api/audit_logs
msapimp-key-api: {{msapimpKey}}
